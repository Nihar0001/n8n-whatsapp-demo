# =============================================================================
# WhatsApp CRM Automation — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before starting containers.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# n8n Core Settings
# -----------------------------------------------------------------------------

# Encryption key for n8n credential storage.
# Generate with: openssl rand -hex 32
# REQUIRED — do not leave blank or n8n will not start correctly.
N8N_ENCRYPTION_KEY=

# The public base URL where n8n is accessible (used in webhook URLs).
# Example: https://n8n.yourdomain.com
# Do NOT include a trailing slash.
WEBHOOK_URL=

# n8n host binding (leave as 0.0.0.0 for Docker)
N8N_HOST=0.0.0.0

# n8n internal port (default 5678; reverse proxy maps 443 → 5678)
N8N_PORT=5678

# n8n protocol — use https in production behind a reverse proxy
N8N_PROTOCOL=https

# Timezone for n8n execution logs and cron triggers.
# Use IANA timezone format: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Example: Asia/Kolkata, UTC, America/New_York
GENERIC_TIMEZONE=Asia/Kolkata

# n8n log level: error | warn | info | debug | verbose
N8N_LOG_LEVEL=warn

# Maximum number of concurrent workflow executions.
# Lower = more stable; higher = more throughput.
EXECUTIONS_PROCESS=main
N8N_CONCURRENCY_PRODUCTION_LIMIT=10

# Allow accessing environment variables within workflow expressions
N8N_ENVS_MODE=local
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# How long (in hours) to retain execution history in n8n UI.
# 168 = 7 days. Set to 0 to keep forever (not recommended for production).
EXECUTIONS_DATA_MAX_AGE=168

# Prune old execution data automatically (true/false)
EXECUTIONS_DATA_PRUNE=true

# -----------------------------------------------------------------------------
# n8n Basic Authentication (n8n UI login)
# -----------------------------------------------------------------------------

# Protect the n8n UI with basic auth.
# In production always enable this or use n8n user management.
N8N_BASIC_AUTH_ACTIVE=true

# n8n UI login username
N8N_BASIC_AUTH_USER=admin

# n8n UI login password — use a strong random password
# Generate with: openssl rand -base64 24
N8N_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Database (SQLite — default, sufficient for low-medium volume)
# -----------------------------------------------------------------------------

# Database type: sqlite or postgresdb
# For production with >1000 executions/day, switch to postgresdb.
DB_TYPE=sqlite

# SQLite database file path inside the container (do not change)
DB_SQLITE_DATABASE=/home/node/.n8n/database.sqlite

# -----------------------------------------------------------------------------
# Database — PostgreSQL (uncomment when upgrading from SQLite)
# -----------------------------------------------------------------------------

# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SCHEMA=public

# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------

# The Phone Number ID from Meta Business Manager.
# Found at: Meta Business → WhatsApp → Phone Numbers → Phone Number ID
# Example: 1272089145976311
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Cloud API permanent access token.
# Create a System User token in Meta Business Manager with whatsapp_business_messaging permission.
# WARNING: This is a high-value secret. Rotate every 60 days.
WHATSAPP_ACCESS_TOKEN=

# Webhook verify token — a secret string YOU define.
# Used during Meta webhook registration to verify your endpoint ownership.
# Generate with: openssl rand -hex 16
# Must match exactly what you enter in Meta Business → WhatsApp → Webhooks → Verify Token
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Business Account ID (WABA ID) — found in Meta Business Manager.
# Example: 123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# CRM API (Laravel)
# -----------------------------------------------------------------------------

# Full URL to the Laravel CRM automation endpoint.
# Example (production): https://crm.yourdomain.com/api/automation/leads
# Do NOT use ngrok URLs in production.
CRM_API_URL=

# Bearer token for authenticating n8n → Laravel API calls.
# Generate in Laravel with: php artisan tinker → Str::random(64)
# Must match the token validated by Laravel middleware.
CRM_API_TOKEN=

# Maximum timeout in milliseconds for CRM API HTTP requests.
# Default: 30000 (30 seconds). Increase for slow Laravel responses.
CRM_API_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Google Gemini AI (used in optional AI extraction path)
# -----------------------------------------------------------------------------

# Google AI Studio API key for Gemini 2.5 Flash access.
# Obtain at: https://aistudio.google.com/app/apikey
# Only required if the AI extraction path is active.
GEMINI_API_KEY=

# Gemini model to use (default: models/gemini-2.5-flash)
GEMINI_MODEL=models/gemini-2.5-flash

# -----------------------------------------------------------------------------
# n8n DataTable — Conversation State
# -----------------------------------------------------------------------------

# The n8n DataTable ID for the whatsapp_conversations table.
# Found in n8n UI under: Data → Tables → whatsapp_conversations → URL
# Example: xmAUd6G9ZmSFA0r9
# Note: This is set inside the workflow — keep here for documentation only.
N8N_DATATABLE_ID=xmAUd6G9ZmSFA0r9

# Conversation state TTL in hours.
# If a conversation has not been updated for this many hours, it resets to initial.
# Default: 24 (matches WhatsApp 24-hour messaging window)
CONVERSATION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Docker & Container Settings
# -----------------------------------------------------------------------------

# Docker volume name for n8n data persistence.
# Change only if you need to distinguish between multiple n8n deployments.
N8N_VOLUME_NAME=n8n_data

# Container name for easy identification in docker ps / docker logs.
N8N_CONTAINER_NAME=n8n-whatsapp-crm

# The port on the HOST machine that maps to n8n's internal port.
# Reverse proxy should point to this port.
# Do NOT expose this port directly on the firewall.
N8N_EXTERNAL_PORT=5678
