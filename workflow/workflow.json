    {
      "parameters": {
        "jsCode": "const msg = $('Normalize: Extract Payload').first().json.message?.toLowerCase().trim();\nconst rows = $input.all();\n\n// Find all active conversations and sort by ID descending (most recent first)\nconst activeRows = rows.filter(row => row.json.id && row.json.state !== 'idle' && row.json.completed !== true)\n                       .sort((a, b) => b.json.id - a.json.id);\nconst activeRow = activeRows[0];\n\nlet restartRequired = false;\nlet currentConversation = {};\n\nif (!activeRow) {\n  // No active conversation exists -> must create a new one\n  restartRequired = true;\n} else {\n  // Active conversation exists -> check for manual restart keyword or 24h timeout\n  const updatedAt = activeRow.json.updated_at ? new Date(activeRow.json.updated_at).getTime() : 0;\n  const now = new Date().getTime();\n  const hoursSinceUpdate = updatedAt ? (now - updatedAt) / 3600000 : 0;\n  \n  const isRestartKeyword = msg === 'restart' || msg === 'start';\n  const isTimeout = hoursSinceUpdate > 24;\n  \n  if (isRestartKeyword || isTimeout) {\n    restartRequired = true;\n    currentConversation = activeRow.json;\n  } else {\n    // Continue with the active conversation\n    currentConversation = activeRow.json;\n  }\n}\n\nreturn [{\n  json: {\n    ...currentConversation,\n    restart_required: restartRequired\n  }\n}];"
      },
